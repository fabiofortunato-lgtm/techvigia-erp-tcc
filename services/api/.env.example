# VERSÃO ACADÊMICA - TechVigia ERP (Demo)
# Copie este arquivo para ".env" na mesma pasta e ajuste se precisar.

# Banco de dados
DATABASE_URL="postgresql://techvigia:techvigia_academico_dev@localhost:5433/techvigia_academico?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT - troque por valores próprios (qualquer string longa e aleatória serve)
JWT_SECRET="troque-por-um-segredo-proprio-para-esta-copia"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-proprio-para-esta-copia"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP) - deixe em branco para usar a conta de teste automática (Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TechVigia <no-reply@techvigia-demo.com>"

# Storage - deixe em branco (usa disco local por padrão)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# WhatsApp - deixe em branco para a demonstração
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Firebase - não utilizado atualmente
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
