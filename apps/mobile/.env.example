# Copie este arquivo para ".env" (mesma pasta) e ajuste o valor abaixo
# conforme onde você está testando o app. Esse arquivo (.env) é local e
# nunca é sobrescrito quando um zip novo do projeto for aplicado.

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Simulador iOS (Mac):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Celular físico (Expo Go) - troque pelo IP da sua máquina na rede Wi-Fi:
EXPO_PUBLIC_API_URL=http://192.168.0.242:3000
