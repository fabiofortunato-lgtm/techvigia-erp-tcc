{
  "name": "techvigia-erp-academico",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run migrate --workspace=services/api",
    "db:studio": "npm run studio --workspace=services/api"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "packageManager": "npm@10.9.0"
}
